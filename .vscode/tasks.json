{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/UI/main.c",
                "${workspaceFolder}/UI/game/game.c",
                "${workspaceFolder}/UI/UI/design.c",

                "-o",
                "${workspaceFolder}/UI/a.exe",

                "-I",
                "C:/raylib/raylib/src",

                "-L",
                "C:/raylib/raylib/src",

                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
